# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Database Connection
DB_URL=mongodb://localhost:27017/my-database
DB_NAME=derival81-savings-app-db

# Frontend Application Origin (CORS)
FRONTEND_URL=http://localhost:3000

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_access_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=30d
OTP_EXPIRES=1h
RESET_PASS_EXPIRES=1h
BCRYPT_SALT_ROUND=10

# Initial Super Admin Seed Credentials
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=admin_password_123
SUPER_ADMIN_PHONE=01234567890

# Email Configuration (Optional for Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FORM="CareGuide Doctor Tracker <no-reply@careguide.local>"
